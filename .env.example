# データベース（compose の db サービスに渡る）
POSTGRES_ROOT_PASSWORD=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# 公開ドメイン（prod のリバースプロキシ・証明書で使う）
DOMAIN=

# エラートラッキング（GlitchTip / Sentry SDK）
# server は実行時に参照、client は Docker build 時に build arg として渡る
SENTRY_DSN=
VITE_SENTRY_DSN=

# MCP のトランスポート: stdio（開発。Claude Desktop からローカル起動）/ http（配布形。/mcp で公開）
# 未設定なら stdio。http のときは userId をトークンから解決し、RAMI_USER_ID は参照しない
MCP_TRANSPORT=http
