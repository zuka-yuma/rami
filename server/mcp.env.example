# ホストから MCP サーバーを起動する時だけ使う（npm run mcp:dev → tsx --env-file=mcp.env）
# compose 経由の dev / prod は server/.env の db:5432 を使うので、このファイルは不要
#
# ホストからは compose のコンテナ名 db を解決できないため localhost:5432 を指定する。
# ユーザー名・パスワードはルートの .env の POSTGRES_USER / POSTGRES_PASSWORD と同じ値、
# DB 名は開発用の rami を指定する。
DATABASE_URL=postgres://<user>:<password>@localhost:5432/rami
